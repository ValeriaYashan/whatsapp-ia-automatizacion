# Copiar a .env y completar. Nunca commitear el .env real.

# Twilio (Console > Account > API keys & tokens)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ↑ En el sandbox es el número que da Twilio. En producción, el número real
#   del cliente ya dado de alta como WhatsApp Sender (con prefijo whatsapp:).

# A dónde llegan los avisos de escalamiento (WhatsApp de la persona responsable)
NOTIFICACION_WHATSAPP_TO=whatsapp:+541140791007

# Anthropic
ANTHROPIC_API_KEY=

# Modelo principal (verificar que siga vigente en docs.claude.com)
MODELO_PRINCIPAL=claude-sonnet-4-6

# Apagado manual: poner en 'true' para pausar el bot sin tocar código ni
# desregistrar el número. budget-guard.js no escribe esta variable solo;
# el apagado automático por tope de gasto se controla con la lógica de
# server.js, esta variable es para el apagado de emergencia manual.
BOT_PAUSADO=false

PORT=3000
